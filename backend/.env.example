# ==========================================
# Server Configuration
# ==========================================
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Public origin of this backend, embedded into the open pixel and click links
# inside every email. MUST be publicly reachable (deployed URL, Cloudflare
# Tunnel, or paid ngrok) for real recipients; localhost and free-tier ngrok
# will NOT work from Gmail/Outlook.
#
# Production:   TRACKING_BASE_URL=https://your-public-domain.com
# Cloudflare:   TRACKING_BASE_URL=https://your-tunnel-id.trycloudflare.com
# ngrok (paid): TRACKING_BASE_URL=https://abc123.ngrok-free.app
TRACKING_BASE_URL=

# ==========================================
# Edge Tracking (test-only, additive)
# ==========================================
# TRACKING_MODE selects which open-tracking implementation emails carry:
#   legacy (default) — existing Express tracking ONLY (unchanged behaviour).
#   edge              — ALSO appends the Supabase Edge Function pixel
#                       (supabase/functions/campaign-tracker) to every email so
#                       both methods can be compared side by side.
TRACKING_MODE=edge
SUPABASE_EDGE_FUNCTION_URL=https://your-project-ref.supabase.co/functions/v1

# ==========================================
# Supabase Configuration
# ==========================================
# Project URL (Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (secret) — bypasses Row Level Security for backend operations
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# SMTP Email Configuration (Gmail / ESP)
# ==========================================
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@example.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=your-email@example.com
EMAIL_FROM_NAME=Your Sender Name
EMAIL_SECURE=false
EMAIL_REPLY_TO=your-email@example.com
EMAIL_UNSUBSCRIBE_MAILTO=mailto:your-email@example.com?subject=Unsubscribe

# ==========================================
# Application Settings & Pacing
# ==========================================
BATCH_SIZE=10
EMAIL_DELAY_MS=1000
BATCH_DELAY_MS=5000
MAX_RETRIES=3
CRON_SCHEDULE=* * * * *

# Minimum seconds between sent_at and an open request to count as a human open.
# Keep 0 so Gmail/Outlook image proxy prefetch is recorded.
TRACKING_MIN_OPEN_DELAY=0
